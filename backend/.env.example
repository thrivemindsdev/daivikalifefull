# ============================================================
# Daivika API (Laravel) — copy to .env and fill in.
# Variable names are the same as the old Next.js backend, so existing values can be copied over.
# Everything marked REQUIRED must be set in production.
# ============================================================

APP_NAME="Daivika API"
APP_ENV=production
APP_DEBUG=false
# REQUIRED. Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://YOUR_DOMAIN

# ── Database (REQUIRED) ─────────────────────────────────────
# Same PostgreSQL database the store already uses. In Docker Compose the host is the service name (postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/daivika_db

# ── Authentication (REQUIRED) ───────────────────────────────
# Long random string, at least 32 characters (openssl rand -base64 48).
# Keep the old backend's value to keep customers signed in.
JWT_SECRET=
# Built-in admin login. In production the admin login is disabled unless both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Daivika Administrator"
ADMIN_PHONE=

# ── Site URL (used in admin email links) ────────────────────
FRONTEND_URL=https://YOUR_DOMAIN

# ── Razorpay (REQUIRED for online payments / COD advance) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → https://YOUR_DOMAIN/api/payment/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# ── Cashfree (optional, legacy return/webhook only) ─────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── Web push notifications (same keys as the storefront's NEXT_PUBLIC_VAPID_PUBLIC_KEY) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@YOUR_DOMAIN

# ── Admin email alerts (optional) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=

# ── Cloudinary (image & video storage) ──────────────────────
# Without these, uploaded images are stored in PostgreSQL instead
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Clixdot/Daivika

# ── SMS OTP login (MSG91 with a DLT registered template) ────
SMS_PROVIDER=msg91
SMS_API_KEY=
DLT_ENTITY_ID=
DLT_SENDER_ID=
DLT_OTP_TEMPLATE_ID=
# Exact approved template text; {#var#} is replaced with the OTP
DLT_OTP_TEMPLATE_TEXT=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ── Runtime (defaults are fine for one server) ──────────────
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning
