# ============================================================
# Daivika storefront (Next.js) — copy to .env.local and fill in.
# The database, payment secrets, SMS, email and Cloudinary keys now belong to the Laravel backend:
# see backend/.env.example.
# ============================================================

# Where the Laravel API runs. Every /api/* request from the browser is forwarded there.
#   Docker Compose: http://backend:8000   Local development: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# ── Site URLs ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
NEXT_PUBLIC_API_BASE_URL=https://YOUR_DOMAIN/api
FRONTEND_URL=https://YOUR_DOMAIN

# ── Public keys used in the browser (built into the site at build time) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
